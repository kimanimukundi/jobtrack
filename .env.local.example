# Supabase — get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JSearch via RapidAPI (free tier — 200 req/month)
# Sign up at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key

# Resend (free — 3,000 emails/month)
# Sign up at: https://resend.com
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Cron job secret (make up any random string — used to secure the cron endpoint)
CRON_SECRET=your_random_secret_string

# App URL (used for email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
